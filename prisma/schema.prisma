// Calendry — multi-tenant calendar/timetabling platform.
//
// This file is the FIXED CORE TAXONOMY (TAXONOMY.md §1): entity types and their
// relationships. Changing anything here is a migration, not a config change.
//
// Tenant-configurable VOCABULARY lives in rows, not in this schema: Role,
// Equipment, SessionKind and Constraint parameters are all data. Adding a role
// or a session kind must never require touching this file.
//
// Things this schema CANNOT express, which live in the hand-written companion
// migration instead (see prisma/migrations/*_rls_triggers_and_indexes):
//   - row-level security policies (tenant isolation, TAXONOMY.md §2)
//   - the group_closure maintenance trigger (TAXONOMY.md §6)
//   - append-only enforcement on generation / session_event (TAXONOMY.md §3)
//   - partial indexes (the solver's `WHERE is_locked = false` exclusion path)

datasource db {
  provider = "postgres"
}

generator client {
  provider = "prisma-client-js"
}

// ---------------------------------------------------------------------------
// Enums — structural, therefore fixed. Anything tenant-extensible is a table.
// ---------------------------------------------------------------------------

/// Kinds of academic-calendar period. Structural (TAXONOMY.md §2 names these
/// explicitly as core from day one), so an enum rather than tenant vocabulary.
/// How an Offering's demand distributes across a Term.
///
/// FIXED, not tenant vocabulary (TAXONOMY.md's open/fixed split), because the
/// values are the proto's `SchedulingPattern` and a new one is a schema change
/// in three repos.
///
/// NULL on the column is NOT a third value: it means unclassified, which is
/// every Offering that exists today and the honest state for one nobody has
/// decided about. It maps to `SCHEDULING_PATTERN_UNSPECIFIED`, the same claim.
enum SchedulingPattern {
  /// A consistent weekly slot for the whole Term. Widely assumed and enforced
  /// by nothing until a tenant enables the matching constraint.
  DISTRIBUTED
  /// The whole demand concentrated into a short contiguous window.
  BLOCK

  @@map("scheduling_pattern")
}

enum CalendarPeriodKind {
  HOLIDAY
  BREAK
  EXAM

  @@map("calendar_period_kind")
}

/// Whether a declared unavailability window is actually in force.
///
/// Self-declared windows land PENDING and are INERT until an administrator
/// approves them — `Person.blackouts` on the wire carries approved rows only.
/// That gate exists because a veto is a HARD constraint: an unreviewed one can
/// make a term infeasible, and the failure surfaces as unplaced Sessions with
/// nothing pointing back at the cause.
///
/// An administrator writing one directly (`availability.manage_any`) is
/// approving their own authorized action, so it is written APPROVED with
/// themselves recorded as the decider rather than queued for a rubber stamp.
enum PersonUnavailabilityStatus {
  PENDING
  APPROVED
  REJECTED

  @@map("person_unavailability_status")
}

/// Which owner a Generation came from.
enum GenerationSource {
  SOLVER
  MANUAL_BASELINE
  IMPORT

  @@map("generation_source")
}

/// Lifecycle of ONE solver run. Mirrors calendry.solver.v1.RunStatus, plus
/// PENDING for the window this app owns alone.
///
/// There is deliberately no SUCCEEDED_WITH_VIOLATIONS. RunStatus describes the
/// run's lifecycle, not the solution's quality — a completed run carrying
/// residual hard violations is a normal outcome under warn-and-allow
/// (CLAUDE.md), and the violations live in the result, not in this column.
/// Encoding them here would bake in the classification the wire protocol
/// deliberately refused to make.
enum SolverRunStatus {
  /// Row written, StartRun not yet acknowledged. App-only: the row must exist
  /// before the call so the one-active-run index can reject a concurrent
  /// second attempt.
  PENDING
  QUEUED
  RUNNING
  SUCCEEDED
  CANCELLED
  FAILED

  @@map("solver_run_status")
}

/// One request to the external solver service.
///
/// The solver is stateless and persists nothing beyond an in-flight run, so
/// this table is the app's only record that a run happened. It holds the
/// request (scope, budget, seed) and the last status snapshot — enough to
/// explain or reproduce a run without asking the solver anything.
model SolverRun {
  id       String @id @default(uuid(7))
  tenantId String @map("tenant_id")
  termId   String @map("term_id")

  /// The solver's own run id, from StartRunResponse. Null until StartRun acks.
  externalRunId String? @map("external_run_id")

  status SolverRunStatus @default(PENDING)

  /// SolveScope exactly as sent: offeringIds, groupIds, outsideScopePolicy.
  scope Json @default("{}")

  /// Reproducibility inputs. `seed` is what the solver reported USING, echoed
  /// back from StartRunResponse — a request of 0 means it chose its own.
  seed          BigInt?
  maxWallMillis Int?    @map("max_wall_millis")
  maxMoves      BigInt? @map("max_moves")

  /// Last GetStatus snapshot. Overwritten per poll, not appended — the run's
  /// history is not something anything needs.
  progress          Float   @default(0)
  bestObjective     Float?  @map("best_objective")
  movesEvaluated    BigInt? @map("moves_evaluated")
  elapsedMillis     Int?    @map("elapsed_millis")
  /// "move_budget" | "time_budget" | "converged" | "cancelled". Read this
  /// before claiming a run is reproducible: only a time_budget run is not.
  terminationReason String? @map("termination_reason")

  errorDetail String? @map("error_detail")

  /// Stage 5 fills this when a result is materialized into a Generation.
  /// Nullable and unused until then.
  generationId String? @map("generation_id")

  /// Provenance and solver-side echoes. Stage 2 marks every run with
  /// `inputSource: "stage-2-placeholder"`, because the input is hand-written
  /// rather than assembled from tenant data.
  meta Json @default("{}")

  /// The {week, day, block} that "now" mapped to when this run was started.
  /// Stored because it is derived from the clock and therefore the one input a
  /// replay cannot reconstruct — without it the determinism guarantee is
  /// quietly false. Written by Stage 3.
  referenceSlot Json? @map("reference_slot")

  /// SHA-256 of the serialized SolverInput. Makes "did these two runs see the
  /// same problem?" answerable instead of assumed.
  inputHash String? @map("input_hash")

  /// When the background poller should next ask the solver about this run.
  /// Cadence as DATA: it survives restarts and makes "why is this stuck?"
  /// answerable with a query. Null once the run is terminal.
  nextPollAt DateTime? @map("next_poll_at") @db.Timestamptz(3)

  /// Attempts made to re-fetch a SUCCEEDED run's missing result. Bounded at 5:
  /// the solver's registry is in-memory, so once it restarts the result is
  /// genuinely gone and retrying forever would be a lie told slowly.
  resultRecoveryAttempts Int @default(0) @map("result_recovery_attempts")

  /// Set when recovery gave up. The run STILL SUCCEEDED — only the capture
  /// failed — which is why this is a separate fact rather than a status.
  /// "Result lost" is `status = SUCCEEDED AND result_lost_at IS NOT NULL`.
  resultLostAt DateTime? @map("result_lost_at") @db.Timestamptz(3)

  /// The solver's SolverOutput, captured the moment the run went terminal.
  ///
  /// Captured eagerly because the solver keeps runs in an in-memory registry
  /// with no persistence — a restart loses the answer. Storing it here makes
  /// applying it (Stage 5) a database→database transform that cannot fail
  /// because a service bounced.
  result Json? @db.JsonB

  requestedById String?   @map("requested_by_id")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  startedAt     DateTime? @map("started_at") @db.Timestamptz(3)
  finishedAt    DateTime? @map("finished_at") @db.Timestamptz(3)
  lastPolledAt  DateTime? @map("last_polled_at") @db.Timestamptz(3)

  tenant      Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  term        Term                  @relation(fields: [termId], references: [id], onDelete: Cascade)
  generation  Generation?           @relation(fields: [generationId], references: [id], onDelete: SetNull)
  requestedBy Person?               @relation(fields: [requestedById], references: [id], onDelete: SetNull)
  snapshot    SolverInputSnapshot?

  /// At most one PENDING/QUEUED/RUNNING run per term, enforced by the partial
  /// unique index `solver_run_one_active_per_term` in migration
  /// 20260816120000_solver_run. Prisma cannot express a partial unique index,
  /// so it exists in SQL only — `prisma migrate dev` will offer to drop it as
  /// drift. Do not let it (see CLAUDE.md).
  @@index([tenantId])
  @@index([tenantId, termId])
  @@index([generationId])
  @@map("solver_run")
}

/// The full `SolverInput` a run actually sent, not just its hash (issue #24).
///
/// Keyed by `SolverRun`, not `Generation`: `inputHash` already lives on the
/// run, a Generation can have several runs (retries before one succeeds), and
/// only one of them is "the run that produced this Generation"
/// (`SolverRun.generationId`). Answering "what was configured when this
/// calendar was generated" is `SolverRun.findFirst({ where: { generationId } })`,
/// then this table — the snapshot follows the same owner its hash already has
/// rather than inventing a second relationship to the same fact.
///
/// A DEDICATED table, not a column on `solver_run`: this is the single
/// largest and most sensitive payload the app stores (a tenant's whole
/// scheduling configuration — people, groups, rooms, preferences — at one
/// moment), so it must not bloat the hot `solver_run` table that every
/// ordinary status query touches, and its own read path can carry a stricter
/// permission (`solver.snapshot.read`) than triggering or watching a run
/// needs.
///
/// Compressed rather than raw: gzip over the SAME ENCODED PROTOBUF BYTES
/// `inputHash` is a SHA-256 digest of — never a JSON rendering, for the exact
/// reason `hashInput`'s own doc comment gives (key order, BigInt stringifying).
/// Storing the encoding `inputHash` already committed to, rather than
/// re-deriving one, is what keeps the two facts about the same run from ever
/// disagreeing.
model SolverInputSnapshot {
  id          String @id @default(uuid(7))
  tenantId    String @map("tenant_id")
  solverRunId String @unique @map("solver_run_id")

  compressedInput Bytes @map("compressed_input")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  solverRun SolverRun @relation(fields: [solverRunId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("solver_input_snapshot")
}

enum GenerationStatus {
  PENDING
  RUNNING
  READY
  APPLIED
  FAILED
  SUPERSEDED
  INFEASIBLE

  @@map("generation_status")
}

/// Append-only event log vocabulary (TAXONOMY.md §3).
enum SessionEventType {
  CREATE
  MOVE
  SWAP
  DELETE
  /// Changing what an Event IS — title, kind, groups, people — as opposed to
  /// where it sits, which is MOVE. Only ever written for an Event: an
  /// Offering-linked Session takes those from its Offering and from solver
  /// output, so the route that emits this refuses one.
  UPDATE_DETAILS
  /// A manual override of who leads a Session — #7 item 4. Only ever written
  /// when the Session is safe from the next solve: an Event (structurally out
  /// of scope) or a Session already LOCKED. `lecturers.post.ts` refuses
  /// anything else, matching `UPDATE_DETAILS`'s refusal for an unlocked
  /// Offering-linked Session's other fields.
  SET_LECTURERS
  LOCK
  UNLOCK

  /// A whole Generation promoted to baseline. Emitted ONCE per apply, not once
  /// per Session: the Generation is already the immutable record of those
  /// placements, so per-Session events would duplicate it and make replay
  /// ambiguous (apply the snapshot, the events, or both?).
  APPLY_GENERATION

  /// Somebody else covers a Session's placement — Vertretung (issue #30). NOT
  /// `SET_LECTURERS`: that overwrites `session_person` permanently and needs the
  /// Session locked first, because it collides with the next solve. A
  /// substitution changes nothing the solver touches — it is a `SessionSubstitution`
  /// overlay read at display/read time — so it needs no lock and the original
  /// lecturer assignment is never edited. Written for BOTH covering and
  /// reverting (`payload.to: null`), so the log states "who, when" for each.
  SUBSTITUTE
  /// Cancel an Offering-linked Session to the spare bank (issue #22): nulls
  /// its placement but keeps the row, so the teaching stays owed rather than
  /// silently forgotten. Deliberately NOT `DELETE` — the row survives, so
  /// `sessionId` stays populated, unlike `DELETE`'s payload-only record.
  /// `MOVE` restores it, exactly as it repositions any other Session — the
  /// same event type FROM a null placement TO a real one.
  BANK

  @@map("session_event_type")
}

/// Hard constraints are inviolable for the solver but only *flagged* on manual
/// edit (warn-and-allow, TAXONOMY.md §3). Soft constraints carry a penalty.
enum ConstraintSeverity {
  HARD
  SOFT

  @@map("constraint_severity")
}

// ---------------------------------------------------------------------------
// Organizational hierarchy
// ---------------------------------------------------------------------------

/// Optional parent grouping of Tenants that share resources. Owns resources
/// member tenants may reference — the deliberate, narrow exception to tenant
/// isolation. NOT tenant-scoped (it is above the tenant).
model Federation {
  id        String   @id @default(uuid(7))
  slug      String   @unique
  name      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenants   Tenant[]
  sessions  Session[]
  rooms     Room[]
  equipment Equipment[]
  offerings Offering[]

  @@map("federation")
}

/// A single institution. THE isolation boundary — every tenant-scoped table
/// carries tenant_id and is filtered by row-level security, not app code.
model Tenant {
  id           String  @id @default(uuid(7))
  federationId String? @map("federation_id")
  slug         String  @unique
  name         String

  /// Institution-local timezone. All grid and solver logic runs in this zone;
  /// Person.timezone is presentation-only and must never reach constraint
  /// evaluation (TAXONOMY.md §2, §8).
  timezone String @default("UTC")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  federation Federation? @relation(fields: [federationId], references: [id], onDelete: Restrict)

  people                       Person[]
  roles                        Role[]
  groups                       Group[]
  groupTerms                   GroupTerm[]
  groupAvailability            GroupTermAvailability[]
  screens                      Screen[]
  apiTokens                    ApiToken[]
  icsLinks                     IcsLink[]
  screenRooms                  ScreenRoom[]
  memberships                  Membership[]
  personRoles                  PersonRole[]
  rooms                        Room[]
  equipment                    Equipment[]
  roomEquipment                RoomEquipment[]
  timeGrids                    TimeGrid[]
  displaySettings              TenantDisplaySettings?
  timeGridBreaks               TimeGridBreak[]
  terms                        Term[]
  calendarPeriods              CalendarPeriod[]
  sessionKinds                 SessionKind[]
  offerings                    Offering[]
  offeringGroups               OfferingGroup[]
  offeringLecturers            OfferingLecturer[]
  offeringEquipment            OfferingEquipment[]
  offeringTemplates            OfferingTemplate[]
  offeringPlans                OfferingPlan[]
  offeringPlanItems            OfferingPlanItem[]
  sessions                     Session[]
  sessionGroups                SessionGroup[]
  sessionPeople                SessionPerson[]
  sessionRooms                 SessionRoom[]
  constraints                  Constraint[]
  constraintScopes             ConstraintScope[]
  generations                  Generation[]
  sessionEvents                SessionEvent[]
  constraintViolations         ConstraintViolation[]
  groupClosures                GroupClosure[]
  accessRoles                  AccessRole[]
  accessRolePermissions        AccessRolePermission[]
  personAccessRoles            PersonAccessRole[]
  solverRuns                   SolverRun[]
  solverInputSnapshots         SolverInputSnapshot[]
  authSettings                 TenantAuthSettings?
  personUnavailability         PersonUnavailability[]
  personPreferences            PersonPreference[]
  personPreferenceRoomFeatures PersonPreferenceRoomFeature[]
  sessionSubstitutions         SessionSubstitution[]

  @@index([federationId])
  @@map("tenant")
  examRequests ExamRequest[]
  groupSources GroupSource[]
  constraintRelationMembers ConstraintRelationMember[]
}

// ---------------------------------------------------------------------------
// People & roles
// ---------------------------------------------------------------------------

/// The ONLY person entity (TAXONOMY.md §2). No Student/Lecturer/Staff tables —
/// what someone *is* comes from PersonRole, which is tenant vocabulary.
model Person {
  id       String @id @default(uuid(7))
  tenantId String @map("tenant_id")

  /// Stable id from an external SIS/LDAP, for import reconciliation (§8).
  externalRef String? @map("external_ref")

  givenName  String  @map("given_name")
  familyName String  @map("family_name")
  email      String?

  /// Display/export only (TAXONOMY.md §8). Never used in scheduling logic.
  timezone String?

  /// BCP-47 tag (e.g. "de-DE"). NULL = inherit the tenant's `defaultLocale`,
  /// which itself falls back to the request's Accept-Language header — see
  /// `server/utils/locale.ts`'s `resolveLocale`. Display/formatting only,
  /// same as `timezone`: never affects what UI text says (issue #19's
  /// territory), only how dates and numbers are drawn (issue #17).
  locale String?

  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  personRoles       PersonRole[]
  memberships       Membership[]
  sessionPeople     SessionPerson[]
  offeringLecturers OfferingLecturer[]
  generations       Generation[]
  sessionEvents     SessionEvent[]
  accountLink       AccountPerson?
  authSessions      AuthSession[]
  accessRoles       PersonAccessRole[]
  solverRuns        SolverRun[]
  apiTokens         ApiToken[]
  icsLinks          IcsLink[]

  /// Unavailability declared ABOUT this person (TAXONOMY.md §7, LecturerVeto).
  unavailability          PersonUnavailability[] @relation("PersonUnavailabilitySubject")
  /// Rows this person SUBMITTED — their own, or somebody else's as an admin.
  unavailabilitySubmitted PersonUnavailability[] @relation("PersonUnavailabilityAuthor")
  /// Rows this person approved or rejected.
  unavailabilityDecided   PersonUnavailability[] @relation("PersonUnavailabilityDecider")

  preference PersonPreference?

  /// Sessions this Person is COVERING for somebody else (issue #30) — never the
  /// original lecturer's own row, which stays in `sessionPeople`.
  substitutionsCovering SessionSubstitution[]

  @@unique([tenantId, email])
  @@unique([tenantId, externalRef])
  @@index([tenantId])
  @@map("person")
  examRequestsMade     ExamRequest[] @relation("ExamRequestRequestedBy")
  examRequestsDecided  ExamRequest[] @relation("ExamRequestDecidedBy")
}

/// Tenant-defined vocabulary. `lecturer` is the one universal key (the person
/// who leads a Session) and is marked is_system so tenants cannot delete it;
/// everything else — student, auditor, TA, external — is theirs to define.
model Role {
  id       String @id @default(uuid(7))
  tenantId String @map("tenant_id")

  key         String
  name        String
  description String?

  /// True only for the fixed `lecturer` key. Provisioning creates it per
  /// tenant; it is required vocabulary, not seed data.
  isSystem Boolean @default(false) @map("is_system")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  personRoles       PersonRole[]
  sessionPeople     SessionPerson[]
  offerings         Offering[]
  offeringLecturers OfferingLecturer[]
  offeringTemplates OfferingTemplate[]

  @@unique([tenantId, key])
  @@index([tenantId])
  @@map("role")
}

/// Person ↔ Role.
model PersonRole {
  id       String @id @default(uuid(7))
  tenantId String @map("tenant_id")
  personId String @map("person_id")
  roleId   String @map("role_id")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([personId, roleId])
  @@index([tenantId])
  @@index([roleId])
  @@map("person_role")
}

/// One declared unavailability window for a Person (TAXONOMY.md §7).
///
/// Maps 1:1 to `calendry.solver.v1.Unavailability`, INCLUDING its emptiness
/// convention: an EMPTY array means "every value on that axis", so `{days:[5]}`
/// is every Friday and `{blocks:[0]}` is every first block. NOTE that
/// `person_preference` below INVERTS this — there an empty array means "no
/// preference". Two adjacent tables with opposite emptiness semantics is
/// exactly what a later reader gets wrong, so both say so.
///
/// Rows are IMMUTABLE once submitted: editing is delete-then-resubmit. An edit
/// would need its own re-enters-pending state machine, and every deletion
/// RELAXES the problem — approval exists to stop unilateral tightening, so a
/// person may always delete their own row whatever its status.
model PersonUnavailability {
  id       String @id @default(uuid(7))
  tenantId String @map("tenant_id")

  /// Whose time this is about.
  personId String @map("person_id")

  /// ISO weekday numbers, 1 = Monday. Empty = every day.
  days   Int[]
  /// 0-based block index within the day. Empty = every block.
  blocks Int[]
  /// Index into the term's calendar weeks. Empty = every week.
  ///
  /// Only meaningful alongside `termId`, because the index counts weeks of ONE
  /// term's calendar — the same index is thirteen months apart between this
  /// tenant's two terms. A database CHECK enforces the pairing.
  weeks  Int[]

  /// Which term's weeks `weeks` counts, and which solves this row applies to.
  ///
  /// NULL means EVERY term, which is what a recurring weekly pattern ("never
  /// Friday afternoons") means and what every row written before this column
  /// existed meant. Set for a date-range absence, which is anchored to real
  /// dates and therefore to one term.
  termId String? @map("term_id")

  reason String?

  status PersonUnavailabilityStatus @default(PENDING)

  /// Who submitted it — the person themselves, or an administrator acting for
  /// them. NULLABLE with ON DELETE SET NULL for the same reason
  /// `session_event.session_id` is: an audit pointer must be allowed to outlive
  /// the row it names, and deleting an administrator must not cascade away the
  /// vetoes they entered for other people.
  createdByPersonId String? @map("created_by_person_id")

  /// Who decided, and when. `decided_at` is the FACT and carries the CHECK;
  /// `decided_by_person_id` is a pointer that a person deletion may detach,
  /// which is why the constraint is written against the timestamp instead.
  decidedByPersonId String?   @map("decided_by_person_id")
  decidedAt         DateTime? @map("decided_at") @db.Timestamptz(3)
  /// Shown to the submitter on rejection, so a refusal is never silent.
  decisionNote      String?   @map("decision_note")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant    Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  term      Term?   @relation(fields: [termId], references: [id], onDelete: Cascade)
  person    Person  @relation("PersonUnavailabilitySubject", fields: [personId], references: [id], onDelete: Cascade)
  createdBy Person? @relation("PersonUnavailabilityAuthor", fields: [createdByPersonId], references: [id], onDelete: SetNull)
  decidedBy Person? @relation("PersonUnavailabilityDecider", fields: [decidedByPersonId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([termId])
  /// The review queue's own query: pending rows in this tenant.
  @@index([tenantId, status])
  /// The solver read path: approved rows for a set of people.
  @@index([personId, status])
  @@map("person_unavailability")
}

/// Soft scheduling preferences for one Person — "prefers mornings", "prefers
/// Tuesdays".
///
/// THE TWO AXES ARE ADDITIVE: each earns credit independently, so a Tuesday
/// first block earns both. The data deliberately cannot express "Tuesday
/// mornings only" — that conjunction would need a (day x block) matrix rather
/// than two arrays, and is a separate preference kind if anyone ever needs it.
/// Stated here because nothing else states it, and the first evaluator to read
/// these columns would otherwise fix the semantics by accident.
///
/// SOLVER-EFFECTIVE since 2026-08-27. `assembleSolverInput` reads this into
/// `SolverInput` as `Person.preferred` (proto 0.7.0), narrowed to the solved
/// Term's grid, and the solver evaluates `person_preference_fit` against it
/// (`calendry-solver` 41f6227) by charging the mean UNMET fraction per
/// placement.
///
/// This comment said the opposite until stage 5 landed — "nothing reads this,
/// because the wire has no field for it" — and all three clauses had become
/// false: something reads it, the field exists, and it is `Person.preferred`
/// rather than the `preferred_days` / `preferred_blocks` named here. Corrected
/// rather than left to be deleted later, because a stale comment on a schema
/// column is read as current by whoever finds it next.
///
/// This is NOT the `lecturer_veto` bug repeating itself, and the three
/// properties that keep it out of that hole still hold: the rule is SOFT (a
/// mistake prices rather than refuses), it is OFF BY DEFAULT (no tenant's
/// timetable moves without someone choosing it), and the assembly report counts
/// the wholly-inert case so "configured but silent" is distinguishable from
/// "configured and satisfied" — which is exactly what nothing did for
/// `lecturer_veto`.
///
/// An ABSENT row means "no preferences", so the write path DELETES the row when
/// both arrays end up empty: that state then has exactly one representation
/// instead of two that render identically.
model PersonPreference {
  /// Also the primary key: a Person has at most one preference row by
  /// construction, not by a unique index somebody could drop.
  personId String @id @map("person_id")
  tenantId String @map("tenant_id")

  /// ISO weekday numbers, 1 = Monday. EMPTY MEANS NO PREFERENCE — the opposite
  /// of `person_unavailability` above, where empty means every value.
  preferredDays   Int[] @map("preferred_days")
  /// 0-based block index within the day. Empty means no preference.
  preferredBlocks Int[] @map("preferred_blocks")

  /// How much THIS person's preference counts, relative to the tenant-wide
  /// weight on the `person_preference_fit` constraint row.
  ///
  /// NULL means "use the tenant default" and is the only representation of that
  /// state, the same discipline that makes an absent ROW mean "no preferences".
  /// Clamped to [0.5, 2.0] by a CHECK and by the administrator write path.
  ///
  /// A MULTIPLIER rather than an absolute weight, because an absolute override
  /// silently rots when the tenant changes its default: raising the default
  /// from 5 to 20 would turn "count this person double" into "count them at a
  /// fifth". A dimensionless factor is unaffected.
  ///
  /// `Float`, not `Decimal`: the wire field is a `double` and the solver
  /// multiplies doubles, so this keeps one representation end to end. Both
  /// clamp bounds are exactly representable.
  ///
  /// ADMINISTRATOR-ONLY. The self-service path REFUSES this field rather than
  /// dropping it — a person raising their own weight is the unilateral
  /// escalation that soft preferences are otherwise free of, and it is the one
  /// place the two write paths stop being the same operation.
  weightMultiplier Float? @map("weight_multiplier")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  roomFeatures PersonPreferenceRoomFeature[]

  @@index([tenantId])
  @@map("person_preference")
}

/// Which room types this Person would rather teach in — the second axis of
/// `PersonPreference`, after day/block.
///
/// A JOIN with an FK rather than a `String[]` of keys on the parent row.
/// `preferredDays`/`preferredBlocks` are arrays because they are plain scalars
/// with nothing behind them; Equipment is an entity, and every other reference
/// to it in this schema is an `equipmentId`. A key array would be the one place
/// that is not, and would fail silently: renaming an Equipment's key voids the
/// preference and leaves an inert string nothing contradicts.
///
/// Cascades from the PREFERENCE, not from the Person, so the parent's
/// delete-when-every-axis-is-empty discipline keeps working — otherwise an
/// absent preference and an empty one become two states again.
model PersonPreferenceRoomFeature {
  personId    String @map("person_id")
  equipmentId String @map("equipment_id")
  tenantId    String @map("tenant_id")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  preference PersonPreference @relation(fields: [personId], references: [personId], onDelete: Cascade)
  equipment  Equipment        @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  tenant     Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@id([personId, equipmentId])
  @@index([tenantId])
  @@index([equipmentId])
  @@map("person_preference_room_feature")
}

// ---------------------------------------------------------------------------
// Grouping — nested (TAXONOMY.md §2, §6)
// ---------------------------------------------------------------------------

/// A class, cohort, seminar group. Self-referential: Cohort → Class → Seminar.
/// Conflict propagation runs BOTH directions (a busy parent blocks its
/// children and vice versa), so availability checks read GroupClosure rather
/// than walking this tree.
model Group {
  id            String  @id @default(uuid(7))
  tenantId      String  @map("tenant_id")
  parentGroupId String? @map("parent_group_id")

  name        String
  description String?

  /// Denormalized headcount hint for room-capacity checks. Advisory only —
  /// Membership is the source of truth.
  expectedSize Int? @map("expected_size")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant      Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  parentGroup Group?  @relation("GroupHierarchy", fields: [parentGroupId], references: [id], onDelete: Restrict)
  children    Group[] @relation("GroupHierarchy")

  /// When `sources` were last copied into `memberships`. NULL means never —
  /// which is a different fact from "generated and unchanged since", and the
  /// two read identically in a UI that only counts members.
  membersGeneratedAt DateTime? @map("members_generated_at") @db.Timestamptz(3)

  /// Groups this one draws its members from. A COMBINED group — two cohorts'
  /// Management tracks taught together — is an ordinary root-level Group whose
  /// membership was copied from these, not a second parent above them: the
  /// hierarchy is a tree on the wire and in every closure walk.
  ///
  /// MATERIALISED. Membership is copied on an explicit regenerate, so a solve
  /// today and a solve tomorrow see the same attendees unless somebody asked.
  sources     GroupSource[] @relation("CombinedGroup")
  sourceOf    GroupSource[] @relation("SourceGroup")

  memberships    Membership[]
  offeringGroups OfferingGroup[]
  sessionGroups  SessionGroup[]
  terms          GroupTerm[]
  availability   GroupTermAvailability[]

  ancestorClosures   GroupClosure[] @relation("ClosureAncestor")
  descendantClosures GroupClosure[] @relation("ClosureDescendant")

  @@index([tenantId])
  @@index([parentGroupId])
  @@map("group")
}

/// Transitive closure of the Group tree, maintained by trigger (TAXONOMY.md
/// §6, resolving the §9.3 open item in favour of write-time recompute).
///
/// Contains self-pairs at depth 0, so "G and everything conflicting with G" is
/// a single indexed lookup instead of a recursive CTE re-walked per check.
model GroupClosure {
  ancestorId   String @map("ancestor_id")
  descendantId String @map("descendant_id")
  tenantId     String @map("tenant_id")

  /// 0 = self, 1 = direct child, n = n levels down.
  depth Int

  tenant     Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ancestor   Group  @relation("ClosureAncestor", fields: [ancestorId], references: [id], onDelete: Cascade)
  descendant Group  @relation("ClosureDescendant", fields: [descendantId], references: [id], onDelete: Cascade)

  @@id([ancestorId, descendantId])
  @@index([descendantId])
  @@index([tenantId])
  @@map("group_closure")
}

/// Person ↔ Group.
model Membership {
  id       String @id @default(uuid(7))
  tenantId String @map("tenant_id")
  personId String @map("person_id")
  groupId  String @map("group_id")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)
  group  Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([personId, groupId])
  @@index([tenantId])
  @@index([groupId])
  @@map("membership")
}

// ---------------------------------------------------------------------------
// Space
// ---------------------------------------------------------------------------

/// Federation-ownable (a consortium's shared lecture hall). Exactly one of
/// tenant_id / federation_id is set — enforced by a CHECK constraint in the
/// companion migration, not by convention.
///
/// Online delivery is a virtual Room (is_virtual), not a boolean on Session —
/// keeps room-assignment logic uniform (TAXONOMY.md §2).
model Room {
  id           String  @id @default(uuid(7))
  tenantId     String? @map("tenant_id")
  federationId String? @map("federation_id")

  code     String
  name     String
  capacity Int     @default(0)

  /// Separate, optional capacity for EXAM sittings — spacing and invigilation
  /// reduce usable seats below normal teaching capacity. NULL falls back to
  /// `capacity`, same "NULL is a meaningful fallback" pattern as
  /// `Offering.color`/`Offering.requiredCapacity` above.
  examCapacity Int? @map("exam_capacity")

  location String?

  /// Desirability. Soft constraints minimize use of high-ranking rooms.
  ranking Int @default(0)

  isVirtual Boolean @default(false) @map("is_virtual")
  isActive  Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant     Tenant?     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  federation Federation? @relation(fields: [federationId], references: [id], onDelete: Cascade)

  roomEquipment RoomEquipment[]
  sessionRooms  SessionRoom[]
  screenRooms   ScreenRoom[]

  @@index([tenantId])
  @@index([federationId])
  @@map("room")
  examRequests ExamRequest[]
}

/// Tenant-defined tags (projector, PC lab, lab bench). Federation-ownable for
/// the same reason Room is: a shared hall's equipment must be legible to every
/// member tenant that can book it.
model Equipment {
  id           String  @id @default(uuid(7))
  tenantId     String? @map("tenant_id")
  federationId String? @map("federation_id")

  key         String
  name        String
  description String?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant     Tenant?     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  federation Federation? @relation(fields: [federationId], references: [id], onDelete: Cascade)

  roomEquipment     RoomEquipment[]
  offeringEquipment OfferingEquipment[]
  personPreferences PersonPreferenceRoomFeature[]

  @@index([tenantId])
  @@index([federationId])
  @@map("equipment")
}

/// Room ↔ Equipment.
model RoomEquipment {
  roomId      String @map("room_id")
  equipmentId String @map("equipment_id")

  /// Nullable: most tags are presence-only ("has a projector"); quantity
  /// matters only for countable equipment (24 workstations).
  quantity Int?

  /// Nullable for federation-owned rooms, which have no owning tenant.
  tenantId String? @map("tenant_id")

  tenant    Tenant?   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  room      Room      @relation(fields: [roomId], references: [id], onDelete: Cascade)
  equipment Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)

  @@id([roomId, equipmentId])
  @@index([equipmentId])
  @@index([tenantId])
  @@map("room_equipment")
}

// ---------------------------------------------------------------------------
// Time — per-tenant configuration, never global (TAXONOMY.md §2)
// ---------------------------------------------------------------------------

/// Block length, blocks/day, active days, start hour. The prototype's
/// `timeslot % 3` arithmetic and `timeslot > 14`-means-Saturday MUST resolve
/// against this per tenant. No universal grid shape is seeded anywhere.
model TimeGrid {
  id       String @id @default(uuid(7))
  tenantId String @map("tenant_id")

  name String

  blockLengthMinutes Int @map("block_length_minutes")
  blocksPerDay       Int @map("blocks_per_day")

  /// ISO-8601 weekday numbers (1 = Monday … 7 = Sunday) this grid schedules
  /// on. An array, not a bitmask or a hardcoded Mon–Fri assumption.
  activeDays Int[] @map("active_days")

  startHour   Int @default(8) @map("start_hour")
  startMinute Int @default(0) @map("start_minute")

  /// DEFAULT minutes between consecutive blocks. Named overrides in
  /// `TimeGridBreak` replace it at specific positions; this stays the gap
  /// everywhere they do not.
  breakMinutes Int @default(0) @map("break_minutes")

  /// At most one per tenant, enforced by the partial unique index
  /// `time_grid_one_default_per_tenant` in migration
  /// 20260814120000_time_grid_single_default. Prisma cannot express a partial
  /// unique index, so it exists in SQL only — `prisma migrate dev` will offer to
  /// drop it as "drift". Do not let it (see CLAUDE.md).
  isDefault Boolean  @default(false) @map("is_default")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  constraints Constraint[]
  terms       Term[]
  sessions Session[]
  breaks   TimeGridBreak[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("time_grid")
}

/// A named, non-uniform gap on a TimeGrid — lunch, an afternoon break.
///
/// Sparse: a grid with none behaves exactly as it did when `breakMinutes` was
/// the whole story. The unique index on (grid, position, day) is what makes
/// "one override per slot" a database guarantee rather than application care,
/// and is the main reason this is a table and not a JSON column.
///
/// Never reaches the solver: the wire carries block INDICES, and a gap's
/// duration changes no index, no adjacency and no conflict.
model TimeGridBreak {
  id         String @id @default(uuid(7))
  tenantId   String @map("tenant_id")
  timeGridId String @map("time_grid_id")

  /// The gap FOLLOWS this 0-based block index. A row naming the final block is
  /// inert — there is no later block for it to push.
  afterBlockIndex Int    @map("after_block_index")
  durationMinutes Int    @map("duration_minutes")
  label           String

  /// NULL = every active day, unless a day-specific row exists for the same
  /// `afterBlockIndex`. Same null-means-universal shape as ConstraintScope.
  dayOfWeek Int? @map("day_of_week")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  timeGrid TimeGrid @relation(fields: [timeGridId], references: [id], onDelete: Cascade)

  /// NULLS NOT DISTINCT in SQL, which Prisma cannot express — see the migration.
  @@unique([timeGridId, afterBlockIndex, dayOfWeek])
  @@index([tenantId])
  @@index([timeGridId])
  @@map("time_grid_break")
}

/// Academic term / semester. Core from day one — constraints like "minimize
/// sessions in exam weeks" resolve against CalendarPeriod, never `weeks[-n:]`.
model Term {
  id       String @id @default(uuid(7))
  tenantId String @map("tenant_id")

  name       String
  startDate  DateTime @map("start_date") @db.Date
  endDate    DateTime @map("end_date") @db.Date
  timeGridId String?  @map("time_grid_id")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  timeGrid TimeGrid? @relation(fields: [timeGridId], references: [id], onDelete: Restrict)

  calendarPeriods      CalendarPeriod[]
  /// Week-scoped absences whose week indices count THIS term's calendar.
  personUnavailability PersonUnavailability[]
  offerings            Offering[]
  sessions             Session[]
  solverRuns           SolverRun[]
  generations          Generation[]
  groups               GroupTerm[]
  groupAvailability    GroupTermAvailability[]
  icsLinks             IcsLink[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("term")
  examRequests ExamRequest[]
}

/// Group ↔ Term: which Terms a Group is available in (TAXONOMY.md §2).
///
/// NO ROW MEANS "AVAILABLE IN EVERY TERM", not "available in none". Fail-open,
/// deliberately and against this codebase's usual instinct: scoping is opt-in,
/// so existing Groups keep working and a newly created one is usable
/// immediately rather than invisible until someone remembers a second step.
///
/// Many-to-many rather than a `term_id` on Group, because the hierarchy mixes
/// two lifetimes. A cohort like "dIT22 S1 4.Semester" belongs to one Term; its
/// parent "IT Security" is a degree programme that persists across all of them
/// and is never directly scheduled. Owning a Group by a Term would force either
/// a cross-Term parent — abandoning the model — or a duplicated programme node
/// per Term, which destroys the identity of the thing it names and orphans
/// every `membership` row pointing at last Term's copy.
model GroupTerm {
  groupId  String @map("group_id")
  termId   String @map("term_id")
  tenantId String @map("tenant_id")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  group  Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  term   Term   @relation(fields: [termId], references: [id], onDelete: Cascade)

  @@id([groupId, termId])
  @@index([termId])
  @@index([tenantId])
  @@map("group_term")
}

/// When a Group is available WITHIN one Term — the cohort that runs only the
/// first six weeks.
///
/// AN ABSENT ROW MEANS THE WHOLE TERM. Fail-open, matching `GroupTerm`'s choice
/// for the same reason: scoping is opt-in, so an existing Group keeps working
/// and a new one is schedulable immediately rather than after a second step.
///
/// NOT columns on `GroupTerm`, deliberately, and the reason is a trap rather
/// than taste. That table's row EXISTENCE already means something — and the
/// opposite kind of thing: no row means "every Term", a row means "only these".
/// A date range there would make narrowing a Group inside one Term silently
/// scope it OUT of all the others. It also keeps `GroupTerm` what it is
/// documented to be, a visibility scope that never reaches the solver, where
/// this table exists precisely in order to reach it.
///
/// ONE WINDOW PER (GROUP, TERM), by primary key, so a second is unrepresentable
/// rather than rejected — the same construction as `TenantDisplaySettings`
/// being keyed by `tenantId` alone. The wire could carry several disjoint
/// windows; this is a narrowing of what the tenant can SAY, not of what the
/// solver can honour.
///
/// STORED POSITIVE, SENT NEGATIVE. These are the dates the Group IS available;
/// `assembleSolverInput` inverts them into the complementary week indices as
/// `Group.blackouts`, because the wire has one convention for absence shared
/// with `Person.blackouts`. The inversion happens once, at assembly.
model GroupTermAvailability {
  groupId  String @map("group_id")
  termId   String @map("term_id")
  tenantId String @map("tenant_id")

  /// Both nullable, at least one required (DB CHECK). One-sided is a real
  /// request — "joins in week 5, runs to the end" — and making the caller
  /// restate the Term's own boundary would store a second copy of it that goes
  /// stale when the Term moves.
  availableFrom DateTime? @map("available_from") @db.Date
  availableTo   DateTime? @map("available_to") @db.Date

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  group  Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  term   Term   @relation(fields: [termId], references: [id], onDelete: Cascade)

  @@id([groupId, termId])
  @@index([termId])
  @@index([tenantId])
  @@map("group_term_availability")
}

/// A lobby or corridor display. A DEVICE credential, not a person.
///
/// Holds no AccessRole and no acting Person, which is what settles the
/// authority question by construction rather than by policy: `heldPermissions()`
/// throws 403 the moment `actorPersonId` is null, so a screen key cannot satisfy
/// any permission check — including ones added later. Its authority is its room
/// scope and nothing else.
///
/// NOT a fourth RLS exception. Resolution goes through
/// `calendry_internal.screen_identity()`, parameterised by the secret alone
/// exactly like `session_identity()`; every read after that is an ordinary
/// `withTenant()` transaction. See the migration for the full reasoning.
model Screen {
  id       String @id @default(uuid(7))
  tenantId String @map("tenant_id")

  /// What a human calls it when revoking the right one.
  name String

  /// SHA-256 of the presented key, never the key itself — same treatment
  /// `auth_session` gives its token, and unique GLOBALLY because the lookup
  /// happens before any tenant is known.
  tokenHash String @map("token_hash")

  /// Revocation without deletion, so a display taken down for a week keeps its
  /// name and room scope.
  isActive Boolean @default(true) @map("is_active")

  /// Last successful board fetch — the only way to tell a working display from
  /// a dark one without walking to it.
  lastSeenAt DateTime? @map("last_seen_at") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  rooms  ScreenRoom[]

  @@unique([tokenHash])
  @@index([tenantId])
  @@map("screen")
}

/// Which Rooms a Screen shows. NO ROWS MEANS EVERY ROOM — fail-open, matching
/// `GroupTerm`, because a scopeless screen should show the building rather than
/// a blank wall that looks exactly like a broken display.
model ScreenRoom {
  screenId String @map("screen_id")
  roomId   String @map("room_id")
  tenantId String @map("tenant_id")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  screen Screen @relation(fields: [screenId], references: [id], onDelete: Cascade)
  room   Room   @relation(fields: [roomId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@id([screenId, roomId])
  @@index([roomId])
  @@index([tenantId])
  @@map("screen_room")
}

/// Holidays, break weeks and exam periods as structured data.
model CalendarPeriod {
  id       String @id @default(uuid(7))
  tenantId String @map("tenant_id")
  termId   String @map("term_id")

  kind      CalendarPeriodKind
  name      String
  startDate DateTime           @map("start_date") @db.Date
  endDate   DateTime           @map("end_date") @db.Date

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  term   Term   @relation(fields: [termId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([termId, kind])
  @@map("calendar_period")
}

// ---------------------------------------------------------------------------
// Scheduling — the Offering / Session split (TAXONOMY.md §2)
// ---------------------------------------------------------------------------

/// Tenant-defined vocabulary replacing a fixed Lecture/Exam/Event split.
/// A kind may legitimately have no Group at all (e.g. staff_meeting) — which
/// is exactly why Constraints must declare the kinds they apply to.
/// The fixed classification behind a tenant-named Session kind. See
/// `SessionKind.type`; values are schema-level and adding one is a migration.
enum SessionKindType {
  TEACHING
  EXAM
  ADMIN

  @@map("session_kind_type")
}

model SessionKind {
  id       String @id @default(uuid(7))
  tenantId String @map("tenant_id")

  key   String
  name  String
  color String?

  /// What ROLE this kind plays, as opposed to what the tenant calls it.
  ///
  /// THE FIXED HALF OF AN OPEN VOCABULARY. `key` and `name` stay tenant-owned —
  /// "Klausur" is as valid as "exam" — while this is schema-level, so a rule can
  /// act on the DECLARATION instead of guessing at the string. The two columns
  /// are TAXONOMY.md's open/fixed split drawn through one table.
  ///
  /// A constraint type declaring `appliesToKindType` derives its
  /// `applies_to_kinds` from this and ignores `ConstraintScope` entirely.
  ///
  /// ADMIN is unread by anything today, on purpose: it exists so "neither taught
  /// nor assessed" can be recorded before a rule needs it.
  type SessionKindType @default(TEACHING)

  /// Declares whether this kind is expected to carry Group assignments. Lets
  /// the API reject a Group-based constraint scoped to a groupless kind
  /// (TAXONOMY.md §9.5).
  requiresGroup Boolean @default(true) @map("requires_group")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  offerings         Offering[]
  sessions          Session[]
  constraintScopes  ConstraintScope[]
  offeringTemplates OfferingTemplate[]

  @@unique([tenantId, key])
  @@index([tenantId])
  @@map("session_kind")
  examRequests ExamRequest[]
}

/// DEMAND: "this must happen N times, needs a Lecturer with role X, a Group, a
/// Room with equipment Y, kind Z." The solver's input. Federation-ownable, for
/// cross-enrolled electives shared across member tenants.
model Offering {
  id           String  @id @default(uuid(7))
  tenantId     String? @map("tenant_id")
  federationId String? @map("federation_id")

  termId String  @map("term_id")
  kindId String  @map("kind_id")
  code   String?
  title  String

  /// Display colour for every Session of this Offering, or null to inherit.
  ///
  /// NULL IS THE MEANINGFUL VALUE, not a missing one: it means "take the Session
  /// kind's colour", which is what makes the resolution order stated rather than
  /// hardcoded. A default here would have every Offering claiming a colour it
  /// never chose. Same shape as `SessionKind.color`.
  color String?

  /// How many Sessions must exist for this Offering (hard constraint: exact
  /// frequency). The prototype's `lectures[lecture]` count.
  frequency Int @default(1)

  /// Length of each Session in TimeGrid blocks.
  durationBlocks Int @default(1) @map("duration_blocks")

  /// Whether this Offering's Sessions should spread across the Term or
  /// concentrate into a window. NULL = unclassified; see the enum's comment.
  schedulingPattern SchedulingPattern? @map("scheduling_pattern")

  /// Role a lecturer must hold to lead this Offering. Nullable: many kinds
  /// don't constrain who leads them.
  requiredRoleId String? @map("required_role_id")

  /// Minimum room capacity, gating which Rooms are eligible at all.
  ///
  /// NULL means DERIVED from the attached Groups by `shared/groupCapacity.ts`:
  /// distinct people across the union of every attached Group's own-plus-
  /// descendants closure, falling back to summed `expectedSize` over the
  /// MAXIMAL attached Groups when that closure holds no real membership.
  ///
  /// This comment described the derivation for months before anything did it —
  /// `assembleSolverInput` mapped `?? 0`, and the solver's filter is
  /// `room.capacity < min_capacity`, so 0 meant every Room qualified. An
  /// explicit value still wins; only NULL derives.
  requiredCapacity Int? @map("required_capacity")

  /// How many Rooms ONE Session of this Offering must occupy simultaneously.
  ///
  /// NOT NULLABLE, unlike its neighbours here: `requiredCapacity`'s NULL means
  /// DERIVED and `schedulingPattern`'s means UNCLASSIFIED, but every Session
  /// occupies at least one Room, so 1 is an answer rather than an absence.
  ///
  /// CAPPED AT 4 BY A DATABASE CHECK, mirroring the solver's structural limit
  /// (1 primary + `MAX_ADDITIONAL_ROOMS`). Above it `convert.rs` REFUSES the
  /// whole input rather than truncating, so a stored 5 is not a big number —
  /// it is every run failing for the tenant. `MAX_ROOMS_PER_SESSION` in
  /// `shared/rooms.ts` is the same 4 for the write schema and the form.
  ///
  /// Capacity is SUMMED across the chosen Rooms, not required of each — see the
  /// migration and `Offering.required_room_count` in the proto.
  requiredRoomCount Int @default(1) @map("required_room_count")

  /// May the solver place this Offering in a VIRTUAL Room? Not "is this
  /// online" — online delivery is a virtual Room, not a Session flag
  /// (TAXONOMY.md §2). This is permission for the solver to choose one.
  /// False by default: opting into online delivery is a tenant decision.
  allowOnline Boolean @default(false) @map("allow_online")

  /// Issue #8. PROVENANCE ONLY — which OfferingTemplate this was seeded from,
  /// for UI convenience ("created from Maths — 4x/week") and analytics.
  ///
  /// NOTHING MAY READ THIS TO RESOLVE A CURRENT FIELD VALUE. The template's
  /// shape is COPIED onto the row at creation time, once; editing the template
  /// afterward must not reach back into Offerings already made from it, or a
  /// term's history changes under it. SET NULL on delete for the same reason —
  /// deleting a template must not touch a single field of an Offering that
  /// merely started from it.
  createdFromTemplateId String? @map("created_from_template_id")

  isActive  Boolean  @default(true) @map("is_active")
  notes     String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant              Tenant?           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  federation          Federation?       @relation(fields: [federationId], references: [id], onDelete: Cascade)
  createdFromTemplate OfferingTemplate? @relation(fields: [createdFromTemplateId], references: [id], onDelete: SetNull)
  term         Term        @relation(fields: [termId], references: [id], onDelete: Cascade)
  kind         SessionKind @relation(fields: [kindId], references: [id], onDelete: Restrict)
  requiredRole Role?       @relation(fields: [requiredRoleId], references: [id], onDelete: SetNull)

  groups                        OfferingGroup[]
  lecturers                     OfferingLecturer[]
  equipment                     OfferingEquipment[]
  sessions                      Session[]
  constraintScopes              ConstraintScope[]
  violations                    ConstraintViolation[]
  constraintRelationMemberships ConstraintRelationMember[]

  @@index([tenantId])
  @@index([federationId])
  @@index([termId])
  @@index([createdFromTemplateId])
  @@map("offering")
  examRequests ExamRequest[]
}

/// Offering ↔ Group. Many-to-many: a cross-enrolled elective serves groups
/// from more than one tenant, and collapsing this to a single FK would be a
/// migration to undo later.
/// What this tenant's schedule highlights, and where a colour comes from.
///
/// A SINGLETON per tenant — `tenantId` is the primary key, with no surrogate
/// `id`, so "at most one settings row per tenant" is unrepresentable-otherwise
/// rather than enforced by a constraint someone could drop.
///
/// An ABSENT row means defaults. Provisioning deliberately does not seed one, so
/// a tenant that has never opened the page behaves exactly like one that opened
/// it and changed nothing — there is no third state where settings exist but say
/// nothing.
///
/// It stores no copy of any fact it displays: online delivery is a virtual Room
/// (TAXONOMY.md), and this decides only how that is DRAWN.
model TenantDisplaySettings {
  tenantId String @id @map("tenant_id")

  /// Whether a Session in a virtual Room is marked on the schedule.
  highlightOnline Boolean @default(true) @map("highlight_online")
  onlineColor     String? @map("online_color")

  /// Ordered colour sources, most specific first. A list rather than a boolean
  /// so the tenant states a precedence instead of the renderer assuming one.
  colorSourceOrder String[] @default(["offering", "kind"]) @map("color_source_order")

  /// The chip colour when nothing else supplies one.
  defaultColor String? @map("default_color")

  /// BCP-47 tag. Middle tier of the three-source resolution (issue #17):
  /// a Person's own `locale` wins if set, this is the institution's stated
  /// fallback, and an unauthenticated/unconfigured request falls back
  /// further still to Accept-Language. NULL = no tenant default, defer
  /// straight to the header. Wrong for a Federation whose member
  /// institutions may want different languages — that is why this is
  /// per-tenant, not per-Federation, matching the issue's own framing.
  defaultLocale String? @map("default_locale")

  /// Issue #8. A DEFAULT-BEHAVIOUR bias, not a fork: it decides which Offering
  /// fields the form leads with and which constraint types the catalogue
  /// suggests first, never what an Offering IS or which rules exist. Living on
  /// THIS singleton — rather than a table of its own — is deliberate: the
  /// ticket that added it was explicit that a tenant must not gain a second
  /// "settings exist, absent means defaults" mechanism to keep straight
  /// alongside this one. UNIVERSITY is the default because it is what every
  /// tenant before this field got by construction.
  mode TenantMode @default(UNIVERSITY)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("tenant_display_settings")
}

/// Issue #8. UI/UX bias only (form field prominence, suggested constraint
/// types) — TAXONOMY.md's fixed entity model does not branch on this, and
/// never should: a mode that changed what an Offering IS would be two
/// products sharing a database.
enum TenantMode {
  UNIVERSITY
  SCHOOL

  @@map("tenant_mode")
}

model OfferingGroup {
  offeringId String @map("offering_id")
  groupId    String @map("group_id")
  tenantId   String @map("tenant_id")

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  offering Offering @relation(fields: [offeringId], references: [id], onDelete: Cascade)
  group    Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@id([offeringId, groupId])
  @@index([groupId])
  @@index([tenantId])
  @@map("offering_group")
}

/// Offering ↔ Person, as the lecturer(s) demanded. Role recorded per row:
/// "lecturer" is just the fixed universal Role, so hardcoding it as a column
/// name would push vocabulary into schema.
model OfferingLecturer {
  offeringId String  @map("offering_id")
  personId   String  @map("person_id")
  tenantId   String  @map("tenant_id")
  roleId     String? @map("role_id")

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  offering Offering @relation(fields: [offeringId], references: [id], onDelete: Cascade)
  person   Person   @relation(fields: [personId], references: [id], onDelete: Cascade)
  role     Role?    @relation(fields: [roleId], references: [id], onDelete: SetNull)

  @@id([offeringId, personId])
  @@index([personId])
  @@index([tenantId])
  @@map("offering_lecturer")
}

/// Offering ↔ Equipment: the "needs a Room with equipment Y" requirement.
model OfferingEquipment {
  offeringId  String @map("offering_id")
  equipmentId String @map("equipment_id")
  tenantId    String @map("tenant_id")

  /// Minimum count required, for countable equipment.
  quantity Int?

  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  offering  Offering  @relation(fields: [offeringId], references: [id], onDelete: Cascade)
  equipment Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)

  @@id([offeringId, equipmentId])
  @@index([equipmentId])
  @@index([tenantId])
  @@map("offering_equipment")
}

/// Issue #8. A REUSABLE SHAPE, not a live link: creating an Offering "from" a
/// template COPIES these field values onto the new row once, at creation time.
/// Nothing may resolve an Offering's current fields through this table — see
/// `Offering.createdFromTemplateId`'s own comment. Editing a template only
/// ever affects Offerings created from it AFTER the edit, which is what keeps
/// a term's already-scheduled history from changing under a tenant editing
/// their own catalogue of shapes.
///
/// Closest existing machinery is `defaultConstraintRow` (`shared/
/// constraintTypes.ts`): a stored shape a NEW row is seeded from. The
/// difference is authorship — that catalogue is code, this one is tenant data,
/// so it is a table and CRUD routes rather than a function and a backfill
/// script.
///
/// Deliberately NOT federation-ownable: a template is "how this institution
/// names its own recurring shapes", not a resource a federation shares the way
/// a Room or an Offering itself can be.
model OfferingTemplate {
  id       String @id @default(uuid(7))
  tenantId String @map("tenant_id")

  /// The template's own name in the picker — "Maths — 4x/week", not the
  /// Offering title it seeds. Kept distinct from `title` below because a
  /// template is reused across many concrete Offerings, each of which may want
  /// its own title (a specific class, a specific cohort).
  name String

  /// Every field below mirrors an Offering column it seeds and is OPTIONAL:
  /// a template states only the part of the shape it wants to fix, and a
  /// blank one leaves that field for the person creating the Offering to
  /// decide, exactly as it would if they had started from nothing.
  title             String?
  kindId            String? @map("kind_id")
  code              String?
  color             String?
  frequency         Int?
  durationBlocks    Int?    @map("duration_blocks")
  schedulingPattern SchedulingPattern? @map("scheduling_pattern")

  /// The "lecturer pool" hint (TAXONOMY.md's Role, not a specific Person): a
  /// school's "Mr Schmidt" is named on the created Offering's `lecturers`
  /// relation, one Person at a time, through the ordinary Offering form —
  /// this stays a Role reference so the shape itself never hardcodes an
  /// individual.
  requiredRoleId String? @map("required_role_id")

  requiredCapacity  Int?     @map("required_capacity")
  requiredRoomCount Int?     @map("required_room_count")
  allowOnline       Boolean? @map("allow_online")
  notes             String?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  kind         SessionKind? @relation(fields: [kindId], references: [id], onDelete: SetNull)
  requiredRole Role?        @relation(fields: [requiredRoleId], references: [id], onDelete: SetNull)

  seededOfferings Offering[]
  planItems       OfferingPlanItem[]

  @@index([tenantId])
  @@index([kindId])
  @@index([requiredRoleId])
  @@map("offering_template")
}

/// A reusable, ORDERED set of `OfferingTemplate`s — "this is what a cohort's
/// whole term looks like" (Math, German, PE, ...), so applying one to a Group
/// creates its entire course load in one action instead of one Offering at a
/// time. A template fixes ONE Offering's shape; a plan bundles several.
///
/// The plan does not copy its items' shapes into itself — `OfferingPlanItem`
/// only references a template's id. Applying a plan reads each template's
/// CURRENT shape at apply time, the same "copy happens at use, not at
/// authoring" rule `OfferingTemplate` itself already follows for Offerings.
/// Editing a template after a plan that references it has already been
/// applied changes nothing about the Offerings that earlier apply created —
/// only what the NEXT apply produces.
model OfferingPlan {
  id       String @id @default(uuid(7))
  tenantId String @map("tenant_id")

  name        String
  description String?

  /// This plan's successor — "Semester 3" points at "Semester 4" — so a Group
  /// already on this plan can move forward with no picker: the Term defaults
  /// to whichever starts next after the one it's currently on, per
  /// `nextPlanId`'s own read site. SET NULL on delete: a chain losing its
  /// next link degrades to "no suggested successor", never a dangling id.
  ///
  /// NOT a chain the schema verifies is acyclic or single-stranded — a self
  /// link, a cycle, or two plans both pointing at a third are all storable.
  /// Nothing here walks more than one hop, so nothing is CORRUPTED by one;
  /// it would just make a bad suggestion, the same failure mode as pointing
  /// it at the wrong plan by hand.
  nextPlanId String? @map("next_plan_id")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant   Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  nextPlan OfferingPlan? @relation("PlanSuccession", fields: [nextPlanId], references: [id], onDelete: SetNull)
  items    OfferingPlanItem[]

  /// The plan(s) that name this one as their successor — never walked in
  /// application code (a plan doesn't need to know who points at it), kept
  /// only because Prisma requires the relation's other side to exist.
  precededBy OfferingPlan[] @relation("PlanSuccession")

  @@index([tenantId])
  @@index([nextPlanId])
  @@map("offering_plan")
}

/// One template's membership in one plan, ordered. No shape data of its own —
/// see `OfferingPlan`'s own comment for why applying reads the template
/// fresh rather than a shape frozen at the time it was added.
///
/// CASCADES ON BOTH FOREIGN KEYS, unlike `Offering.createdFromTemplateId`'s
/// SET NULL: that column is pure provenance on a row that is already a
/// complete Offering without it, but a plan item IS the reference — deleting
/// its template leaves nothing behind worth keeping a dangling row for, so it
/// simply drops out of the plan rather than becoming a phantom entry no UI
/// can name.
model OfferingPlanItem {
  id       String @id @default(uuid(7))
  tenantId String @map("tenant_id")

  planId     String @map("plan_id")
  templateId String @map("template_id")

  /// Display/apply order within the plan. Not unique — a full reorder writes
  /// every item's position in one request rather than shuffling by delta.
  position Int

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant   Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan     OfferingPlan     @relation(fields: [planId], references: [id], onDelete: Cascade)
  template OfferingTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([planId])
  @@index([templateId])
  @@map("offering_plan_item")
}

/// PLACED INSTANCE: one atomic Session at a specific week/day/block. This is
/// what gets displayed, moved, swapped, locked, exported and notified about.
///
/// Placement is stored as TimeGrid coordinates (term_week / day_of_week /
/// block_index) because that is what constraints reason about. starts_at and
/// ends_at are DERIVED convenience columns for iCal export and UI rendering —
/// never the source of truth for "same day" or "adjacent slot" logic.
model Session {
  id String @id @default(uuid(7))

  /// Exactly one of tenantId / federationId is set, enforced by the
  /// `session_one_owner` CHECK. A federation-owned Session is a genuinely
  /// shared event (TAXONOMY.md §2 amendment) — readable by every member tenant,
  /// writable by none of them.
  tenantId     String? @map("tenant_id")
  federationId String? @map("federation_id")

  /// Display name, for an EVENT only.
  ///
  /// An Offering-linked Session derives its name from `offering.title` as it
  /// always has; `sessionLabel()` reads this column only when `offeringId` is
  /// NULL, and the create route REFUSES a title alongside an offeringId rather
  /// than storing one nothing will ever render.
  title String?

  /// NULL means this Session is an EVENT — a placement with no recurring
  /// demand behind it (TAXONOMY.md §2). An Event carries no Offering, so it is
  /// in no solve's scope and `planMaterialization()`'s delete partition
  /// (`inScope.has(offeringId)`) cannot reach it. Sent to the solver as
  /// immovable occupancy, never as something to place.
  offeringId String? @map("offering_id")
  termId     String  @map("term_id")
  kindId     String  @map("kind_id")
  timeGridId String? @map("time_grid_id")

  /// 1-based week within the Term. NULL means this Session is BANKED — see the
  /// note above `dayOfWeek`.
  termWeek Int? @map("term_week")

  /// ISO weekday, 1 = Monday … 7 = Sunday. Resolved against TimeGrid.activeDays.
  ///
  /// NULLABLE TOGETHER WITH `termWeek` AND `blockIndex` (never one alone —
  /// `session_placement_sane` enforces all-or-nothing): the "cancel to spare
  /// bank" state (issue #22). A cancelled Offering-linked Session keeps its
  /// row — still counted toward `Offering.frequency`, still carrying its
  /// Groups/People/Rooms — but sits nowhere until a human places it again.
  /// `isPlacedSession()` (`shared/sessionPlacement.ts`) is the one predicate
  /// that reads this; nothing should compare `termWeek` to `null` directly.
  dayOfWeek Int? @map("day_of_week")

  /// 0-based block within the day. Resolved against TimeGrid.blocksPerDay —
  /// never `timeslot % 3`.
  blockIndex Int? @map("block_index")

  /// Length in blocks; defaults from Offering.durationBlocks.
  durationBlocks Int @default(1) @map("duration_blocks")

  /// Excluded from the next solve when true — the solver fills empty slots and
  /// never overwrites a lock (TAXONOMY.md §3). Boolean rather than a status
  /// enum because locking is orthogonal to placement state; backed by a
  /// partial index on the solver's exclusion path.
  isLocked Boolean @default(false) @map("is_locked")

  /// Generation this Session's placement came from. Sessions are current
  /// materialized state; history lives in SessionEvent.
  generationId String? @map("generation_id")

  startsAt DateTime? @map("starts_at") @db.Timestamptz(3)
  endsAt   DateTime? @map("ends_at") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant     Tenant?     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  federation Federation? @relation(fields: [federationId], references: [id], onDelete: Cascade)
  offering   Offering?   @relation(fields: [offeringId], references: [id], onDelete: Cascade)
  term       Term        @relation(fields: [termId], references: [id], onDelete: Cascade)
  kind       SessionKind @relation(fields: [kindId], references: [id], onDelete: Restrict)
  timeGrid   TimeGrid?   @relation(fields: [timeGridId], references: [id], onDelete: SetNull)
  generation Generation? @relation(fields: [generationId], references: [id], onDelete: SetNull)

  groups     SessionGroup[]
  people     SessionPerson[]
  rooms      SessionRoom[]
  violations ConstraintViolation[]

  events            SessionEvent[] @relation("EventSubject")
  counterpartEvents SessionEvent[] @relation("EventCounterpart")

  /// Who is covering THIS occurrence right now, if anyone (issue #30). At most
  /// one active substitute per Session — see the model's own comment for why a
  /// unique `session_id` needs no date range.
  substitution SessionSubstitution?

  @@index([tenantId])
  @@index([federationId])
  @@index([offeringId])
  @@index([generationId])
  @@index([tenantId, termId, termWeek, dayOfWeek, blockIndex])
  @@map("session")
  examRequests ExamRequest[]
}

/// An overlay recording who COVERS one Session occurrence — Vertretung (issue
/// #30). The original lecturer assignment (`session_person`, role = lecturer)
/// is never touched: "Frau Müller's lesson, covered by Herr Schmidt" is a fact
/// ON TOP of "Frau Müller's lesson", not a replacement of it.
///
/// KEYED 1:1 BY `session_id`, NOT A DATE RANGE. A Session already IS one placed
/// occurrence (TAXONOMY.md §2) — a recurring lecture is many Session rows, one
/// per week — so "next week it reverts" is automatic: next week's Session is a
/// DIFFERENT row with no substitution of its own. Covering a run of Sessions
/// while somebody is ill is calling this route once per Session in that range,
/// not a temporal concept the storage needs to express.
///
/// SAME-SLOT, SAME-ROOM ONLY (deliberate, issue #30): nothing here can move the
/// Session or its room. Room-changed substitutions are out of scope.
model SessionSubstitution {
  id       String @id @default(uuid(7))
  tenantId String @map("tenant_id")

  sessionId        String @unique @map("session_id")
  coveringPersonId String @map("covering_person_id")

  reason String?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant         Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  session        Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  coveringPerson Person  @relation(fields: [coveringPersonId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([coveringPersonId])
  @@map("session_substitution")
}

// --- Assignment: three explicit tables, not one polymorphic table. ----------
// A polymorphic assignment(target_type, target_id) cannot carry real foreign
// keys, so the database would stop guaranteeing that an assignment points at a
// live row — unacceptable on the table both the solver and the notification
// fan-out read. The three relations also have different cardinality rules and
// want different indexes (double-booking checks are per-target).

/// Session ↔ Group.
model SessionGroup {
  sessionId String @map("session_id")
  groupId   String @map("group_id")
  tenantId  String @map("tenant_id")

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  group   Group   @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@id([sessionId, groupId])
  @@index([groupId])
  @@index([tenantId])
  @@map("session_group")
}

/// Session ↔ Person, covering BOTH the assigned lecturer(s) and directly
/// assigned individuals. role_id distinguishes them: "lecturer" is the fixed
/// universal Role, so a separate session_lecturer table would hardcode
/// vocabulary the taxonomy explicitly keeps open.
model SessionPerson {
  sessionId String  @map("session_id")
  personId  String  @map("person_id")
  tenantId  String  @map("tenant_id")
  roleId    String? @map("role_id")

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  person  Person  @relation(fields: [personId], references: [id], onDelete: Cascade)
  role    Role?   @relation(fields: [roleId], references: [id], onDelete: SetNull)

  @@id([sessionId, personId])
  @@index([personId])
  @@index([tenantId])
  @@index([roleId])
  @@map("session_person")
}

/// Session ↔ Room. Modelled many-to-many rather than a Session.room_id FK
/// because split/parallel rooms are real, and the double-booking check wants
/// its own index here.
model SessionRoom {
  sessionId String @map("session_id")
  roomId    String @map("room_id")
  tenantId  String @map("tenant_id")

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  room    Room    @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@id([sessionId, roomId])
  @@index([roomId])
  @@index([tenantId])
  @@map("session_room")
}

// ---------------------------------------------------------------------------
// Constraints — structured rule builder, not an expression DSL
// ---------------------------------------------------------------------------

/// A configured instance of a predefined constraint type. `params` is JSONB
/// because rule-builder parameters vary per type (max_online_ratio takes a
/// percentage, lecturer_veto takes day/slot lists) — modelling each type's
/// params as columns would mean a migration per constraint type.
model Constraint {
  id       String @id @default(uuid(7))
  tenantId String @map("tenant_id")

  /// Key from the constraint-type library (§7), e.g. `no_double_booking_room`,
  /// `max_online_ratio_per_group`, `minimize_first_block`.
  type String

  name     String
  severity ConstraintSeverity

  /// Penalty weight. Meaningful only for SOFT; a CHECK in the companion
  /// migration enforces that HARD rows leave it null and SOFT rows set it.
  weight Int?

  /// Rule-builder parameters, shape determined by `type`.
  params Json @default("{}")

  isEnabled Boolean @default(true) @map("is_enabled")

  /// The tenant's single always-present row for this catalogue type
  /// (TAXONOMY.md §2). Exactly one per (tenant, type), enforced by the partial
  /// unique index `constraint_one_default_per_type` — which Prisma cannot
  /// express, so it lives in SQL only. `prisma migrate dev` will offer to drop
  /// it as drift; do not let it (see CLAUDE.md).
  ///
  /// False marks a kind/offering-scoped VARIANT of the same type. A default row
  /// is never deleted through the UI: disabling it is how a tenant opts out,
  /// because deleting it would make the rule unreachable rather than off.
  isDefault Boolean @default(false) @map("is_default")

  /// Restrict this rule to ONE TimeGrid. NULL = every grid.
  ///
  /// A COLUMN, NOT A `ConstraintScope` ROW, because the combination rule
  /// differs: kind scopes are an OR-set ("any of these kinds", none = all),
  /// while a grid is an AND filter on the rule itself. One table carrying both
  /// would make a row's meaning depend on which column is set.
  ///
  /// For rules stated in units the grid defines — a gap between lessons, a cap
  /// on consecutive blocks, a daily span — which two grids cannot mean the same
  /// numbers by. The wire carries nothing for it: `SolverInput.time_grid` is
  /// singular, so a rule naming a different grid than the run's Term is simply
  /// not sent.
  timeGridId String? @map("time_grid_id")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  timeGrid TimeGrid? @relation(fields: [timeGridId], references: [id], onDelete: Cascade)

  scopes          ConstraintScope[]
  violations      ConstraintViolation[]
  relationMembers ConstraintRelationMember[]

  @@index([tenantId])
  @@index([tenantId, isEnabled])
  @@index([timeGridId])
  @@map("constraint_def")
}

/// Which Offerings and/or kinds a Constraint applies to.
///
/// A row scopes by kind, by offering, or by both (offering-and-kind). A
/// Constraint with NO scope rows applies tenant-wide. A CHECK in the companion
/// migration requires at least one of the two FKs per row, so an empty scope
/// row cannot silently mean "everything".
model ConstraintScope {
  id           String  @id @default(uuid(7))
  tenantId     String  @map("tenant_id")
  constraintId String  @map("constraint_id")
  offeringId   String? @map("offering_id")
  kindId       String? @map("kind_id")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant     Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  constraint Constraint   @relation(fields: [constraintId], references: [id], onDelete: Cascade)
  offering   Offering?    @relation(fields: [offeringId], references: [id], onDelete: Cascade)
  kind       SessionKind? @relation(fields: [kindId], references: [id], onDelete: Cascade)

  @@unique([constraintId, offeringId, kindId])
  @@index([tenantId])
  @@index([offeringId])
  @@index([kindId])
  @@map("constraint_scope")
}

/// One Offering's membership in an OfferingRelation (ADR-0028 in
/// calendry-solver: "a relation is an ordered set of Offering references, a
/// relation type, and that type's parameters"). The `Constraint` row IS the
/// relation — its `type` names the relation type (e.g. `different_time`),
/// `severity`/`weight`/`isEnabled` behave exactly as they do for every other
/// type. This table is only the ordered membership.
///
/// A NEW CARRIER, NEVER `ConstraintScope` — scope and membership are opposite
/// meanings that would share a table. For a kind-scoped rule, the named
/// Offering is a FILTER ("this rule applies to X's Sessions"); for a relation,
/// the named Offerings are OPERANDS ("the rule is about the relationship
/// between A and B"), and applying it "to A" alone is meaningless. The same
/// trap `group_term` vs `group_term_availability` already records.
///
/// `position` is stored even though `DifferentTime` (symmetric) ignores it,
/// because a future order-dependent relation type (e.g. Precedence) cannot
/// retrofit an order onto rows that never had one without leaving every
/// existing relation order-ambiguous — cheaper to carry one integer now than
/// to migrate every relation ever created later.
model ConstraintRelationMember {
  id           String @id @default(uuid(7))
  tenantId     String @map("tenant_id")
  constraintId String @map("constraint_id")
  offeringId   String @map("offering_id")
  position     Int

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  constraint Constraint @relation(fields: [constraintId], references: [id], onDelete: Cascade)
  offering   Offering   @relation(fields: [offeringId], references: [id], onDelete: Cascade)

  @@unique([constraintId, offeringId])
  @@index([tenantId])
  @@index([offeringId])
  @@map("constraint_relation_member")
}

// ---------------------------------------------------------------------------
// History — Generation snapshots + append-only event log (TAXONOMY.md §3)
// ---------------------------------------------------------------------------

/// An immutable, versioned snapshot: a solver run or a manual baseline.
/// Manual edits are events applied ON TOP of a Generation to produce current
/// state. UPDATE and DELETE are revoked from the app role in the companion
/// migration — "immutable" enforced by the database.
model Generation {
  id       String @id @default(uuid(7))
  tenantId String @map("tenant_id")

  /// The Term this snapshot describes, or NULL for a tenant-wide one.
  ///
  /// NULL is a real case, not a gap: a MANUAL_BASELINE covers the whole tenant,
  /// and an IMPORT may span terms. A solver Generation always has one — it is
  /// backfilled from the SolverRun that produced it.
  ///
  /// Frozen by `generation_content_immutable`: which term a snapshot describes
  /// is part of what the snapshot IS, like `version` and `source`.
  termId String? @map("term_id")

  /// Sequential per TERM (per tenant for a term-less one). Two partial unique
  /// indexes in the companion migration enforce the two cases separately —
  /// Prisma cannot express either, and a single `@@unique([tenantId, termId,
  /// version])` would treat every tenant-wide row as unique against itself.
  ///
  /// It was tenant-sequential until 20260901040000, which made six terms with
  /// one proposal each read v1..v6 and a version number say nothing about the
  /// history of any one term.
  version Int

  parentGenerationId String? @map("parent_generation_id")

  source GenerationSource
  status GenerationStatus @default(PENDING)

  /// Exactly one current Generation per TERM, and at most one tenant-wide one,
  /// enforced by two partial unique indexes in the companion migration.
  ///
  /// It was one per TENANT, which meant a tenant could not hold an applied
  /// schedule for two terms at once — and `apply` superseded across terms
  /// because of it. § 20260901040000.
  isCurrent Boolean @default(false) @map("is_current")

  /// Solver run metadata: seed, wall time, penalty score, algorithm params.
  solverMeta Json? @map("solver_meta")

  /// Populated instead of placements when the solver reports infeasibility.
  infeasibilityReport Json? @map("infeasibility_report")

  createdById String?   @map("created_by_id")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  appliedAt   DateTime? @map("applied_at") @db.Timestamptz(3)

  tenant           Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// SetNull, not Cascade: `generation_no_delete` denies every DELETE here, so a
  /// cascade could not fire and would fail the Term's deletion instead.
  term             Term?        @relation(fields: [termId], references: [id], onDelete: SetNull)
  parentGeneration Generation?  @relation("GenerationLineage", fields: [parentGenerationId], references: [id], onDelete: SetNull)
  children         Generation[] @relation("GenerationLineage")
  createdBy        Person?      @relation(fields: [createdById], references: [id], onDelete: SetNull)

  sessions   Session[]
  events     SessionEvent[]
  violations ConstraintViolation[]
  solverRuns SolverRun[]

  @@index([tenantId])
  @@index([tenantId, termId])
  @@index([parentGenerationId])
  @@map("generation")
}

/// Append-only log of manual edits, applied on top of a baseline Generation.
/// Enables full replay/rollback to any prior point.
model SessionEvent {
  id       String @id @default(uuid(7))
  tenantId String @map("tenant_id")

  /// Monotonic ordering for replay. Gapless per-tenant ordering is NOT
  /// guaranteed by a global sequence, so replay orders by (created_at, seq).
  seq BigInt @default(autoincrement())

  /// Baseline this event applies on top of.
  generationId String @map("generation_id")

  type SessionEventType

  /// Nullable so a DELETE event survives its Session being removed — the log
  /// must outlive its subject.
  sessionId String? @map("session_id")

  /// The other Session in a SWAP.
  counterpartSessionId String? @map("counterpart_session_id")

  /// Before/after placement snapshot. Self-contained so replay never depends
  /// on rows that may since have changed.
  payload Json @default("{}")

  actorPersonId String?  @map("actor_person_id")
  reason        String?
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant             Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  generation         Generation @relation(fields: [generationId], references: [id], onDelete: Cascade)
  session            Session?   @relation("EventSubject", fields: [sessionId], references: [id], onDelete: SetNull)
  counterpartSession Session?   @relation("EventCounterpart", fields: [counterpartSessionId], references: [id], onDelete: SetNull)
  actor              Person?    @relation(fields: [actorPersonId], references: [id], onDelete: SetNull)

  violations ConstraintViolation[]

  @@index([tenantId, seq])
  @@index([generationId])
  @@index([sessionId])
  @@map("session_event")
}

/// Persisted CURRENT violations, powering warn-and-allow (TAXONOMY.md §3).
///
/// A manual edit that breaks a hard constraint is permitted, so the violation
/// must live somewhere queryable rather than in a one-time response. Rows are
/// refreshed synchronously in the same transaction that emits the
/// SessionEvent — never on a lag or a batch job.
model ConstraintViolation {
  id       String @id @default(uuid(7))
  tenantId String @map("tenant_id")

  constraintId String  @map("constraint_id")
  /// Nullable: a violation may be about an OFFERING rather than a placed
  /// Session. ExactFrequency ("needs 6, placed 4") has no session to name, and
  /// that is exactly the case warn-and-allow was decided around. A CHECK
  /// enforces that at least one of session_id / offering_id is present.
  sessionId    String? @map("session_id")

  /// Set for offering-scoped violations. Without it "constraint X is violated,
  /// no session" says nothing actionable.
  offeringId String? @map("offering_id")

  severity ConstraintSeverity

  /// Weight contribution for SOFT violations; null for HARD.
  penalty Int?

  /// Which entities collided, for UI display without re-running the check.
  detail Json @default("{}")

  /// Provenance: the event or generation that introduced this violation.
  detectedByEventId String? @map("detected_by_event_id")
  generationId      String? @map("generation_id")

  detectedAt DateTime @default(now()) @map("detected_at") @db.Timestamptz(3)

  tenant          Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  constraint      Constraint    @relation(fields: [constraintId], references: [id], onDelete: Cascade)
  session         Session?      @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  offering        Offering?     @relation(fields: [offeringId], references: [id], onDelete: Cascade)
  detectedByEvent SessionEvent? @relation(fields: [detectedByEventId], references: [id], onDelete: SetNull)
  generation      Generation?   @relation(fields: [generationId], references: [id], onDelete: SetNull)

  /// NULLS NOT DISTINCT in the migration — Postgres would otherwise treat
  /// every offering-scoped row as unique against itself and duplicate on each
  /// refresh. Prisma cannot express that, so the index lives in SQL.
  @@unique([constraintId, sessionId, offeringId])
  @@index([tenantId, severity])
  @@index([sessionId])
  @@map("constraint_violation")
}

// ---------------------------------------------------------------------------
// AUTHENTICATION — the pre-tenant data plane
// ---------------------------------------------------------------------------
//
// These three tables sit OUTSIDE row-level security, and that is a deliberate,
// documented exception (the second one in this system, after Federation-owned
// resources).
//
// The reason is structural rather than convenient: a session must be read
// BEFORE the tenant is known, because the session is what determines the
// tenant. An RLS policy on these tables could never be satisfied — there is no
// tenant context to compare against yet. They are therefore only ever queried
// by primary key or unique token from a verified cookie, never by tenant
// filter, and no route may expose them directly.

/// A login credential, belonging to a HUMAN rather than to a Tenant.
///
/// Person is tenant-scoped by design (TAXONOMY.md §2: `person.tenant_id` is NOT
/// NULL), so someone working at two institutions genuinely has two Person rows.
/// Making Person the credential holder would give that human two passwords and
/// two reset flows. Account is the tenant-independent identity that owns them
/// both; the active Tenant is chosen after login, never supplied by the client.
model Account {
  id           String  @id @default(uuid(7))
  email        String  @unique
  passwordHash String  @map("password_hash")
  isActive     Boolean @default(true) @map("is_active")

  /// Set by the operator reset CLI. While true, login authenticates but issues
  /// NO session — the account must change its password first. Deliberately not
  /// a "restricted session": a half-privileged session is a worse failure mode
  /// than asking for the password twice.
  mustChangePassword Boolean @default(false) @map("must_change_password")

  lastLoginAt DateTime? @map("last_login_at") @db.Timestamptz(3)

  /// When the password itself last changed — NOT `updatedAt`, which any field
  /// touches. Drives expiry (issue #13): an account whose password has stood
  /// unchanged past the policy's maximum age is treated the same way a forced
  /// reset is, at login.
  passwordChangedAt DateTime @default(now()) @map("password_changed_at") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  persons  AccountPerson[]
  sessions AuthSession[]

  @@map("account")
}

/// Guards `login` and `change-password` — the two routes that accept a
/// password as proof and answer a generic failure either way, deliberately,
/// so neither is an account-existence oracle. NO RLS, matching `account` /
/// `account_person` / `auth_session`: a rate-limit check runs BEFORE the
/// tenant is known, because the routes it guards are pre-tenant themselves.
///
/// `key` names the ROUTE as well as the account — `login:<email>` and
/// `change_password:<email>` are counted separately, because succeeding at
/// one door must not consume the guessing budget for the other.
model AuthRateLimit {
  key           String   @id
  attemptCount  Int      @default(1) @map("attempt_count")
  windowStart   DateTime @default(now()) @map("window_start") @db.Timestamptz(3)

  @@map("auth_rate_limit")
}

/// Account ↔ Person: the identities one login can act as, one per Tenant.
model AccountPerson {
  accountId String   @map("account_id")
  personId  String   @map("person_id")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  person  Person  @relation(fields: [personId], references: [id], onDelete: Cascade)

  /// A Person answers to exactly one Account — two credentials controlling the
  /// same tenant identity would make audit attribution ambiguous.
  @@id([accountId, personId])
  @@unique([personId])
  @@map("account_person")
}

/// A server-side session, addressed by an opaque token held in an httpOnly
/// cookie.
///
/// Database-backed rather than a JWT because revocation has to be immediate:
/// disabling a Person, revoking an access role, or switching tenant must take
/// effect on the next request, and JWT claims stay valid until they expire.
model AuthSession {
  id        String @id @default(uuid(7))
  accountId String @map("account_id")

  /// Which Person (and therefore which Tenant) this session is currently acting
  /// as. Null immediately after login when the Account has several Persons and
  /// tenant selection is still pending.
  activePersonId String? @map("active_person_id")

  /// SHA-256 of the bearer token. The token itself is never stored, so database
  /// read access does not grant the ability to impersonate a session.
  tokenHash String @unique @map("token_hash")

  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  userAgent String? @map("user_agent")
  ipAddress String? @map("ip_address")

  account      Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  activePerson Person? @relation(fields: [activePersonId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@index([activePersonId])
  @@map("auth_session")
}

// ---------------------------------------------------------------------------
// AUTHORIZATION — permissions and tenant-defined access roles
// ---------------------------------------------------------------------------

/// The fixed catalogue of actions the system can perform.
///
/// Tenants cannot invent permissions, because a permission corresponds to a
/// code path and tenants do not write code. This table is reference data
/// maintained by migration — the one deliberate exception to "no seed data" —
/// so that access_role_permission can carry a real foreign key instead of
/// unvalidated strings.
model Permission {
  key         String @id
  category    String
  description String

  accessRoles AccessRolePermission[]

  @@index([category])
  @@map("permission")
}

/// A tenant-defined, named bundle of Permissions (TAXONOMY.md §4).
///
/// DELIBERATELY SEPARATE from the domain `Role` entity, which is scheduling
/// vocabulary (Lecturer, Student, Auditor — TAXONOMY.md §2). The taxonomy uses
/// the word "role" for both concepts, but they are not the same thing:
/// `offering.required_role_id` means "this Offering needs a Lecturer", and if
/// permission bundles lived on that entity the schema would happily accept an
/// Offering requiring a lecturer with the role "Billing Admin". Keeping them
/// apart keeps that state unrepresentable.
model AccessRole {
  id       String @id @default(uuid(7))
  tenantId String @map("tenant_id")

  key         String
  name        String
  description String?

  /// True for `tenant-admin`, created by provisioning and not deletable.
  isSystem Boolean @default(false) @map("is_system")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  permissions AccessRolePermission[]
  people      PersonAccessRole[]
  /// Tenants whose default-for-new-People setting points at this role — see
  /// `TenantAuthSettings.defaultAccessRoleId`'s `onDelete: Restrict`.
  defaultForTenants TenantAuthSettings[]

  @@unique([tenantId, key])
  @@index([tenantId])
  @@map("access_role")
}

/// AccessRole ↔ Permission.
model AccessRolePermission {
  accessRoleId  String @map("access_role_id")
  permissionKey String @map("permission_key")
  tenantId      String @map("tenant_id")

  accessRole AccessRole @relation(fields: [accessRoleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionKey], references: [key], onDelete: Cascade)
  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@id([accessRoleId, permissionKey])
  @@index([permissionKey])
  @@index([tenantId])
  @@map("access_role_permission")
}

/// Person ↔ AccessRole. What a person may DO, as opposed to what they ARE.
model PersonAccessRole {
  personId     String   @map("person_id")
  accessRoleId String   @map("access_role_id")
  tenantId     String   @map("tenant_id")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  /// True when this grant came from `TenantAuthSettings.defaultAccessRoleId`
  /// rather than an explicit `person_access_role.assign` action (issue #25).
  /// The audit trail the issue asks for: without this, a default grant and a
  /// human's own decision are the same row and indistinguishable later.
  isDefaultGrant Boolean @default(false) @map("is_default_grant")

  person     Person     @relation(fields: [personId], references: [id], onDelete: Cascade)
  accessRole AccessRole @relation(fields: [accessRoleId], references: [id], onDelete: Cascade)
  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@id([personId, accessRoleId])
  @@index([accessRoleId])
  @@index([tenantId])
  @@map("person_access_role")
}

/// Authorization configuration — deliberately NOT part of
/// `TenantDisplaySettings`, which is a display singleton (issue #25 is
/// explicit that this does not belong there).
///
/// Absent row = today's behaviour: nothing is auto-granted, granting stays
/// `person_access_role.assign`'s job, same "singleton, absence means
/// defaults" convention `TenantDisplaySettings` already uses.
model TenantAuthSettings {
  tenantId String @id @map("tenant_id")

  /// AccessRole granted to a newly created Person, in the same transaction.
  /// `onDelete: Restrict` is the "fail loudly" the issue asks for: deleting
  /// an AccessRole that is some tenant's configured default is refused
  /// outright (surfaced as 409 "Still referenced by other records." by the
  /// generic delete route's existing FK-violation mapping) rather than
  /// silently clearing the setting or leaving a dangling reference that
  /// quietly stops granting.
  defaultAccessRoleId String? @map("default_access_role_id")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant            Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  defaultAccessRole AccessRole? @relation(fields: [defaultAccessRoleId], references: [id], onDelete: Restrict)

  @@map("tenant_auth_settings")
}

/// PENDING until somebody with the review key decides. Mirrors
/// `PersonUnavailabilityStatus`, and for the same reason: a lecturer's request
/// adds demand the institution has to find room for.
enum ExamRequestStatus {
  PENDING
  APPROVED
  REJECTED

  @@map("exam_request_status")
}

/// A lecturer's request for an exam on a module they lead, and its decision.
///
/// A REQUEST TABLE, NOT A STATUS ON `Session`. A pending Session would have to
/// be excluded by the schedule view, the solver snapshot, the violation checker
/// and every export — four places the exclusion can be forgotten, and a
/// forgotten filter shows MORE rather than fewer. Nothing queries this table
/// but its own routes.
///
/// APPROVAL CREATES AN EVENT (`Session.offeringId` NULL), never a Session on
/// the module's own Offering: `ExactFrequency` is HARD, so an extra Session on
/// an Offering is either deleted by the next solve or reported as violating the
/// module's own demand. An Event is structurally out of every solve's scope.
model ExamRequest {
  id       String @id @default(uuid(7))
  tenantId String @map("tenant_id")

  /// The module this is an exam FOR — what "my own Offering" is checked
  /// against, and what the created Event borrows its groups and title from.
  /// Never becomes the Session's `offeringId`.
  offeringId String @map("offering_id")
  termId     String @map("term_id")

  /// Must name a kind whose `type` is EXAM. A cross-row condition, so the write
  /// boundary enforces it rather than a CHECK — a non-exam kind would create a
  /// Session no exam rule can see.
  kindId String @map("kind_id")

  termWeek       Int @map("term_week")
  dayOfWeek      Int @map("day_of_week")
  blockIndex     Int @map("block_index")
  durationBlocks Int @default(1) @map("duration_blocks")

  /// A PREFERENCE, not a reservation. Nothing holds it while the request is
  /// pending, so approval re-checks that it is free.
  roomId String? @map("room_id")

  note String?

  status ExamRequestStatus @default(PENDING)

  requestedByPersonId String?   @map("requested_by_person_id")
  decidedByPersonId   String?   @map("decided_by_person_id")
  decidedAt           DateTime? @map("decided_at") @db.Timestamptz(3)
  decisionNote        String?   @map("decision_note")

  /// The Session approval created. NULL until then, which is what stops a
  /// second approval creating a second exam.
  sessionId String? @map("session_id")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  offering    Offering    @relation(fields: [offeringId], references: [id], onDelete: Cascade)
  term        Term        @relation(fields: [termId], references: [id], onDelete: Cascade)
  kind        SessionKind @relation(fields: [kindId], references: [id], onDelete: Restrict)
  room        Room?       @relation(fields: [roomId], references: [id], onDelete: SetNull)
  session     Session?    @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  requestedBy Person?     @relation("ExamRequestRequestedBy", fields: [requestedByPersonId], references: [id], onDelete: SetNull)
  decidedBy   Person?     @relation("ExamRequestDecidedBy", fields: [decidedByPersonId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([requestedByPersonId])
  @@index([offeringId])
  @@map("exam_request")
}

/// One Group a combined Group draws its members from.
///
/// The INTENT behind a membership that would otherwise look hand-assembled:
/// without this, somebody adds forty students and nothing records why those
/// forty, or how to do it again next term.
model GroupSource {
  tenantId      String @map("tenant_id")
  groupId       String @map("group_id")
  sourceGroupId String @map("source_group_id")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant      Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  group       Group  @relation("CombinedGroup", fields: [groupId], references: [id], onDelete: Cascade)
  sourceGroup Group  @relation("SourceGroup", fields: [sourceGroupId], references: [id], onDelete: Cascade)

  @@id([groupId, sourceGroupId])
  @@index([tenantId])
  @@index([sourceGroupId])
  @@map("group_source")
}

/// A personal API credential (import scripts, integrations). Acts AS ITS
/// PERSON, but only within the permission subset selected at creation — and
/// never more than that Person holds at the moment of use: `heldPermissions()`
/// intersects `permissions` with the Person's live set on every request, so
/// revoking an AccessRole also narrows every token derived from it.
///
/// Bound to a Person, not an Account: permissions are per-Person, so a token is
/// one tenant identity. Resolution is privileged the same way `Screen` is —
/// `calendry_internal.api_token_identity()`, by the secret alone — and the
/// table itself is tenant-scoped and RLS-protected like everything else.
model ApiToken {
  id       String @id @default(uuid(7))
  tenantId String @map("tenant_id")
  personId String @map("person_id")

  /// What a human calls it when revoking the right one.
  name String

  /// SHA-256 of the presented token, never the token itself. Unique GLOBALLY
  /// because the lookup happens before any tenant is known.
  tokenHash String @map("token_hash")

  /// Permission keys selected at creation. A CEILING, not a grant.
  permissions String[]

  /// Revocation without deletion, so a token disabled during an incident keeps
  /// its name and its `lastUsedAt` trail.
  isActive Boolean @default(true) @map("is_active")

  /// NULL = does not expire. Enforced at resolution, not by a sweep.
  expiresAt DateTime? @map("expires_at") @db.Timestamptz(3)

  /// Last successful resolution, throttled to once a minute in SQL — the only
  /// way to answer "is anything still using this?" before revoking it.
  lastUsedAt DateTime? @map("last_used_at") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@unique([tokenHash])
  @@index([tenantId])
  @@index([personId])
  @@map("api_token")
}

/// ALL streams every Term the Person has a Session in, bounded by
/// `weeksAhead`; TERM streams exactly `termId`, unbounded (a Term is already a
/// bounded range).
enum IcsLinkScope {
  ALL
  TERM

  @@map("ics_link_scope")
}

/// A personal calendar-subscription link (issue #15, the stream half — the
/// one-off download it replaces was the other half, `buildIcs`/
/// `schedule.ics.get.ts`). A signed-in Person mints one and pastes it into an
/// external calendar app, which re-fetches it on its own schedule.
///
/// THE SECRET IS STORED PLAIN, unlike ApiToken/Screen. Deliberately: this is
/// not a one-time bearer credential, it is a "capability URL" a person must be
/// able to come back and re-copy — into a second device, after clearing a
/// calendar app's subscriptions — without losing sync elsewhere by rotating
/// it. It is read-only, scoped to exactly this Person's own Sessions, and
/// revoked by deleting the row.
///
/// Resolution is privileged the same way Screen/ApiToken are —
/// `calendry_internal.ics_link_identity()`, by the token alone — and the
/// table itself is tenant-scoped and RLS-protected like everything else.
model IcsLink {
  id       String @id @default(uuid(7))
  tenantId String @map("tenant_id")
  personId String @map("person_id")

  /// What a human calls it when deleting the right one.
  name String

  /// The bearer secret itself — see the model comment for why this is not a
  /// hash. Unique GLOBALLY because the lookup happens before any tenant is
  /// known.
  token String

  scope IcsLinkScope

  /// Set only when `scope` is TERM.
  termId String? @map("term_id")

  /// Rolling window in weeks from "now", ALL scope only. A Term already
  /// bounds itself; "all Terms" does not, and an external calendar app that
  /// refetches on its own schedule needs a request that stays cheap no matter
  /// how many Terms this Person has ever had a Session in.
  weeksAhead Int? @map("weeks_ahead")

  /// Last successful stream fetch, throttled to once a minute in SQL — the
  /// only way to tell a link a calendar app still polls from one nobody uses.
  lastUsedAt DateTime? @map("last_used_at") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)
  term   Term?  @relation(fields: [termId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([tenantId])
  @@index([personId])
  @@map("ics_link")
}
